@page "{id:int}"
@model CRUD_Razor.DeleteModel
@{ ViewData["Title"] = "Delete book"; }
<p class="eyebrow">BOOK REGISTER</p>
<h1>Delete book</h1>

<p>Are you sure you want to delete this book? This cannot be undone.</p>

<dl class="row">
    <dt class="col-sm-2">Title</dt>
    <dd class="col-sm-10">@Model.Book.title</dd>

    <dt class="col-sm-2">Author</dt>
    <dd class="col-sm-10">@Model.Book.author</dd>

    <dt class="col-sm-2">Publisher</dt>
    <dd class="col-sm-10">@Model.Book.publisher</dd>
</dl>

<form method="post" asp-route-id="@Model.Book.Id">
    <button type="submit" class="btn btn-danger">
        Confirm Delete
    </button>

    <a asp-page="Index" class="btn btn-secondary">Cancel</a>
</form>
