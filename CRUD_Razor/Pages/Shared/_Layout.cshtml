<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>@ViewData["Title"] | Book Register</title>
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<a class="skip-link" href="#main">Skip to content</a>
<header><nav class="container navigation" aria-label="Main navigation">
<a class="brand" asp-page="/Index">Book Register<small>Sir Umer's assignment</small></a>
<div class="actions"><a asp-page="/Books/Index">All books</a><a class="btn btn-primary" asp-page="/Books/Create">Add book</a></div>
</nav></header>
<main id="main" class="container main-content">
@if (TempData["SuccessMessage"] is string message) { <div class="notice" role="status">@message</div> }
@RenderBody()
</main>
<footer class="container">Book Management System · ASP.NET Core Razor Pages · SQL Server</footer>
@await RenderSectionAsync("Scripts", required: false)
</body></html>
