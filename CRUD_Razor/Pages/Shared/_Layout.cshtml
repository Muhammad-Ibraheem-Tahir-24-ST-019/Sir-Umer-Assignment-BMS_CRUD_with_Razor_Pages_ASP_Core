<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>@ViewData["Title"] | Book Register</title>
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<a class="skip-link" href="#main">Skip to content</a>
<header><nav class="container navigation" aria-label="Main navigation">
<a class="brand" asp-page="/Index">Book Register<small>Sir Umer's assignment</small></a>
<div class="actions"><a asp-page="/Books/Index">All books</a><a class="btn btn-primary" asp-page="/Books/Create">Add book</a></div>
</nav></header>
<main id="main" class="container main-content">
@if (TempData["SuccessMessage"] is string message) { <div class="notice" role="status">@message</div> }
@if (ViewData["DatabaseUnavailable"] is true)
{
    IgnoreBody();
    <section class="panel database-unavailable" role="alert">
        <p class="eyebrow">BOOK REGISTER</p>
        <h1>Database unavailable</h1>
        <p>The book register cannot connect to its database right now. Books cannot be loaded or saved until the connection is restored.</p>
        <p>If you are setting up this assignment for the first time, follow the database setup steps in the project README.</p>
        <div class="actions">
            <a class="btn btn-primary" asp-page="/Books/Index">Try again</a>
            <a class="btn btn-secondary" asp-page="/Index">Back to home</a>
        </div>
    </section>
}
else
{
    @RenderBody()
}
</main>
<footer class="container">Book Management System · ASP.NET Core Razor Pages</footer>
@await RenderSectionAsync("Scripts", required: false)
</body></html>
